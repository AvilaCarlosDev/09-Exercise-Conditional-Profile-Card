{
  "env": {
    "browser": true,
  },
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "strict":0,
    "no-unused-vars": 0,
    "no-console": 0,
    "semi": ["error", "always"],
    "comma-dangle": [1, { //when to use the last comma
        "arrays": "never",
        "objects": "never",
        "imports": "never",
        "exports": "never",
        "functions": "ignore",
    }],
  },
  "extends": ["eslint:recommended"]
}
